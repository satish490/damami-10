<?php

/**
 * @file
 * Install, update and uninstall functions for visitor_counter module.
 */

/**
 * Implements hook_schema().
 */
function visitor_counter_schema() {
  $schema = [];

  // Table: visitor_quavigo
  $schema['visitor_quavigo'] = [
    'description' => 'Stores each visitor hit.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'client_ip' => [
        'type' => 'varchar',
        'length' => 45,
        'not null' => FALSE,
      ],
      'created_date' => [
        'type' => 'varchar', // safer for MySQL/Postgres
        'length' => 20,
        'not null' => FALSE,
      ],
    ],
    'primary key' => ['id'],
  ];

  // Table: visitor_counter_quavigo
  $schema['visitor_counter_quavigo'] = [
    'description' => 'Stores total visitor count.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'visitor_count' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 */
function visitor_counter_install() {
  $database = \Drupal::database();
  $schema = $database->schema();

  // Create visitor_quavigo table
  if (!$schema->tableExists('visitor_quavigo')) {
    $schema->createTable('visitor_quavigo', visitor_counter_schema()['visitor_quavigo']);
  }

  // Create visitor_counter_quavigo table
  if (!$schema->tableExists('visitor_counter_quavigo')) {
    $schema->createTable('visitor_counter_quavigo', visitor_counter_schema()['visitor_counter_quavigo']);

    // Insert default row
    $database->insert('visitor_counter_quavigo')
      ->fields([
        'id' => 1,
        'visitor_count' => 0,
      ])
      ->execute();
  }
}

/**
 * Update hook (IMPORTANT if module already enabled)
 */
function visitor_counter_update_9001() {
  visitor_counter_install();
}