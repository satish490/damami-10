<div class="bannerVideoWrap">
  <!-- 🎥 VIDEO -->
  <video
    autoplay
    muted
    loop
    playsinline
    class="bannerVideo"
  >
    <source src="{{ fields.field_video_file.content }}">

  </video>

  <!-- 🔊 Unmute Button (Optional) -->
  <button id="unmuteBtn">🔊 Enable Sound</button>
</div>
