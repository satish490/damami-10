{% set video_file = row._entity.field_video_file.entity %}
{% if video_file %}
  <div class="bannerVideoWrap">
    <video class="bannerVideo" autoplay muted loop playsinline>
      <source src="{{ file_url(video_file.fileuri) }}" type="{{ video_file.filemime.value }}">
    </video>
    <button type="button" id="unmuteBtn">🔊 {{ 'Enable Sound'|t }}</button>
  </div>
{% endif %}
