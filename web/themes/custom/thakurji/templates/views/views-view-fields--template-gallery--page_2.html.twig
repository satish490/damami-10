{% set raw_category = fields.field_video_category.content|striptags %}
{% set category_class = raw_category|clean_class %}

<div class="gallery-card {{ category_class }}">
  <div class="gallery-image">
    {% if fields.field_upload_file_video.content is not empty %}
      {{ fields.field_upload_file_video.content }}
    {% else %}
      {{ fields.field_youtube_video.content }}
    {% endif %}
    <span class="gallery-badge">{{ raw_category }}</span>
  </div>
  <div class="gallery-info">
    <h3 class="gallery-title">{{ fields.title.content }}</h3>
  </div>
</div>
