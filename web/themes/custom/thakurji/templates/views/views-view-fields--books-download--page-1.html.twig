
<div class="col-lg-4 col-md-6 mb-4">
  <div class="press-card">

    {# IMAGE FIELD #}
    {% set image_file = row._entity.field_upload_image.entity ?? null %}
    {% if image_file %}
      {% set image_url = image_file.uri.value|file_url %}
    {% endif %}

    {# PDF FIELD #}
    {% set pdf_file = row._entity.field_upload_pdf.entity ?? null %}
    {% if pdf_file %}
      {% set pdf_url = pdf_file.uri.value|file_url %}
      {% set pdf_size = pdf_file.filesize.value|format_size %}
    {% endif %}

    <div class="card-image-wrapper">
      {% if image_file %}
        <img src="{{ image_url }}" alt="image" class="card-image">
      {% else %}
        <img src="/themes/custom/thakurji/images/pdf.svg" alt="Default" class="card-image">
      {% endif %}
    </div>

    <div class="card-body-content">      
      <div class="press-release-title">
        {{ fields.title.content }}
      </div>
    </div>

    <div class="card-actions">
      {% if pdf_file %}
        <a href="{{ pdf_url }}" target="_blank" rel="noopener noreferrer" class="read-more-btn">
          {% trans %} Download Books {% endtrans %}
        </a>

        <p class="item-des">
          <a href="{{ pdf_url }}" target="_blank" rel="noopener noreferrer">
            <span class="fileSize">({{ pdf_size }})</span>
          </a>
        </p>
      {% endif %}
    </div>

  </div>
</div>