<div class="sidebar-press-item">
	<div class="sidebar-press-image">
		<img src="{{ fields.field_upload_image.content }}" alt="{{ fields.field_upload_image.alt }}">
		<span class="sidebar-date-badge">{{ fields.field_blog_date.content }}</span>
	</div>
	<ul class="card-category mb-1">
		<li>{{ fields.field_author_name.content }}</li>
	</ul>
	<div class="sidebar-press-title">
		{{ fields.title.content }}
	</div>
	<a href="{{ fields.view_node.content }}" class="link1">{% trans %} Read More {% endtrans %}</a>
</div>