                    <path data-name="Path 167117"
                      d="M16.327,135.543h0l-3.371-3.355a.645.645,0,0,0-.91.915l2.263,2.252H.645a.645.645,0,0,0,0,1.29H14.308L12.045,138.9a.645.645,0,0,0,.91.915l3.371-3.355h0A.646.646,0,0,0,16.327,135.543Z"
                      transform="translate(0 -132)" fill="#01588e" />
                  </g>
                </g>
              </svg>

            </a>
          </div>
        </div>
