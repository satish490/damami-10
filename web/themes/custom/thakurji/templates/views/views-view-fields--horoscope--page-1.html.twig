<div class="col-lg-4 col-md-6 mb-4">
      <div class="press-card">
        <div class="card-image-wrapper">
          <img src="{{ fields.field_horscope_image.content }}" alt="events" class="card-image">
          <div class="date-badge">{{ fields.field_date.content }}</div>
        </div>
        
        <div class="card-body-content">
          <ul class="card-category mb-2">
            <li>{{ fields.field_days.content }}</li>
          </ul>
          
          <div class="press-release-title">
            {{ fields.title.content }}
          </div>
        </div>
        
        <div class="card-actions">
            <a href="{{ fields.view_node.content }}" class="read-more-btn">
