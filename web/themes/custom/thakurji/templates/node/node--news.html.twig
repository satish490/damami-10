

<article{{ attributes.addClass('news-article') }}>
  <header class="news-hero">
    <div class="news-media">
      {# Image (renders with the field’s formatter). Add an image style in the field display if needed. #}
      {% if content.field_upload_image %}
        <div class="news-image">
          {{ content.field_upload_image }}
        </div>
      {% endif %}
      <div class="news-badges">
        {% if node.field_homepage_display.value == '1' %}
          <span class="badge badge-accent">{{ 'Homepage'|t }}</span>
        {% endif %}
      </div>
    </div>

    <div class="news-head">
      <h1 class="news-title">{{ label }}</h1>

      <div class="news-meta">
        {% set display_date = node.field_news_date.value ?: node.created.value %}
        <time datetime="{{ display_date|date('c') }}">
          {{ display_date|date('d M Y') }}
        </time>
      </div>

  <div class="news-body">
    {{ content.body }}
  </div>
    </div>
  </header>



</article>
